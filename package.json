{
  "name": "soulside-ai",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @soulside/web --filter @soulside/api run dev",
    "dev:web": "pnpm --filter @soulside/web dev",
    "dev:api": "pnpm --filter @soulside/api dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "simulate": "tsx simulate_workflow.ts",
    "simulate:scenarios": "tsx simulate_workflow.ts --scenarios-only",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "ws": "^8.21.1"
  }
}
